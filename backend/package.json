  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.5.4"
  },
